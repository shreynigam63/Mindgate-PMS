[Unit]
Description=Agentic PMS database backup
Documentation=file:/opt/agentic-pms/deploy/README.md
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/agentic-pms/deploy/service/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentic-pms-backup
