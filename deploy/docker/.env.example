# Agentic PMS — Docker deployment settings.
#
#   cp .env.example .env
#   chmod 600 .env
#   then fill in the three CHANGE_ME values below.
#
# This file is a template and is committed. The .env you create from it
# holds live secrets and is git-ignored — keep it that way, and never
# paste its contents into a ticket, a chat, or a screenshot.

# ---- Database ------------------------------------------------------------
POSTGRES_USER=apms
POSTGRES_DB=apms
# CHANGE_ME. Generate one instead of inventing one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# ---- Application ---------------------------------------------------------
# CHANGE_ME. Signs every session token. Rotating it logs everyone out,
# which is the correct behaviour if it ever leaks.
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# CHANGE_ME. Names this tenant. Lowercase, no spaces — e.g. the customer's
# short name. SET IT ONCE: it is resolved to a tenant id on first boot and
# stamped onto every row, so changing it later does not rename the tenant,
# it silently switches to a different (empty) one.
TENANT_SLUG=CHANGE_ME

# Local email+password login. Required: it is the only login path that
# exists in this build — the OIDC/IdP provider is scaffolded but not
# implemented, so setting this to false locks everyone out including the
# administrator. See "Authentication" in deploy/README.md before changing.
AUTH_DEV=true

# Port the box listens on. Leave at 80 unless something else already has
# it, or you are terminating TLS in front of this (ALB, or nginx/caddy on
# the host) and want the app on a loopback port instead.
HTTP_PORT=80

# Container timezone. Affects the timestamps in logs and the local time
# the daily reminder sweeps report — not scheduling itself, which is a
# 24h interval from boot.
TZ=Asia/Kolkata

# ---- AI features (optional) ----------------------------------------------
# Leave EMPTY to run without AI. Every agentic endpoint then returns a
# clean 503 ("Agentic features are not configured on this instance") and
# nothing else in the app changes — the AI is additive, never load-bearing.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
